    <eClassifiers xsi:type="ecore:EClass" name="IFcalFactory" abstract="true" interface="true"/>
<eClassifiers xsi:type="ecore:EClass" name="INTERNAL_GPS_DETAILEDINFO_R" eSuperTypes="#//types/IArrayType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Latitude -> Latitude is the angular distance of a place North or South of the earth's equator, range:[-90, +90]&#xA;&#xA;Longitude -> Longitude is the angular distance of a place East or West of the meridian, range:[-180, +180]&#xA;&#xA;Altitude -> How high or low the device/location is relation to the sea level&#xA;&#xA;TimeStamp -> Epoch time when the GPS data transmitted from satellite&#x9;&#xA;&#xA;HorizontalAccuracy -> Measure of how close a reported position is accurate on earth surface&#x9;&#xA;&#xA;VerticalAccuracy -> Measure of how close a reported position is accurate to sea level&#xA;&#xA;HorizontalDil -> Horizontal Dilution of precision, range:[1, infinity]&#xA;&#xA;PositionDil -> Position Dilution of Precision, range:[1, infinity] (RCU target doest not provide PDOP, set to default value -99.999)&#xA;&#xA;VerticalDil -> Vertical Dilution of Precision, range:[1, infinity]&#xA;&#xA;TimeDil -> Time Dilution of Precision, range:[1, infinity]&#xA;&#xA;Speed -> Speed of the GPS device&#xA;&#xA;Course -> Direction in which the device is heading to, range:[0, 359.99]&#xA;&#xA;NumberOfSatellites -> Number of satellites used in determining GPS fix"/>
        <details key="arrayfeatures" value="latitude,longitude,altitude,timeStamp,horizontalAccuracy,verticalAccuracy,horizontalDil,positionDil,verticalDil,timeDil,speed,course,numberOfSatellites"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="latitude" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
          defaultValueLiteral="0.0">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="access" value="Read"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="longitude" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
