  <eSubpackages name="cloud" nsURI="com.bosch.nevonex.cloud" nsPrefix="cloud">
    <eClassifiers xsi:type="ecore:EClass" name="ICloudDownload" instanceClassName="com.bosch.fsp.runtime.feature.ICloudDownload"
        abstract="true" interface="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="Cloud" eSuperTypes="#//cloud/ICloudDownload #//types/PropertyChange">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="Cloud_Download" value="true"/>
      </eAnnotations>
      <eOperations name="processDownloadMessage">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="It processes the message/file received from cloud."/>
        </eAnnotations>
        <eParameters name="message" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eOperations>
      <eOperations name="initPlatformService" eExceptions="#//exception/MachineInitException"/>
      <eOperations name="startPlatformService" eExceptions="#//exception/MachineInitException"/>
      <eOperations name="stopPlatformService" eExceptions="#//exception/NevonexException"/>
      <eOperations name="getFilePath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Returns file path of latest downloaded file. (ICloudDownload contract)"/>
        </eAnnotations>
      </eOperations>
      <eOperations name="uploadData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          eExceptions="#//exception/CloudBadRequestException #//exception/CloudUnAuthorizedException #//exception/CloudAccessDeniedException #//exception/CloudConnectionException #//exception/PlatformServiceException #//exception/FileNotFoundException #//exception/IOException">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Uploads given data to Nevonex Cloud"/>
        </eAnnotations>
        <eParameters name="data" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Data to be uploaded"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Priority of the upload 1. High, 2. Medium, 3.Low"/>
          </eAnnotations>
        </eParameters>
      </eOperations>
      <eOperations name="uploadData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          eExceptions="#//exception/CloudBadRequestException #//exception/CloudUnAuthorizedException #//exception/CloudAccessDeniedException #//exception/CloudConnectionException #//exception/PlatformServiceException #//exception/FileNotFoundException #//exception/IOException">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Uploads given data to Nevonex Cloud using wifi or satellite based on the selected connection type."/>
        </eAnnotations>
        <eParameters name="data" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Data to be uploaded"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Priority of the upload 1. High, 2. Medium, 3.Low"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="connectionType" eType="#//common/ConnectionTypeEnum">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Type of communication which should be used for uploading data. The allowable connection types are WIFI,SATELLITE. If this value is null WIFI is selected by default."/>
          </eAnnotations>
        </eParameters>
      </eOperations>
      <eOperations name="uploadFile" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          eExceptions="#//exception/CloudBadRequestException #//exception/CloudUnAuthorizedException #//exception/CloudAccessDeniedException #//exception/CloudConnectionException #//exception/PlatformServiceException #//exception/FileNotFoundException #//exception/IOException">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Uploads given file to Nevonex Cloud"/>
        </eAnnotations>
        <eParameters name="file" eType="#//types/File">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="File which has to be uploaded"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Priority of the upload 1. High, 2. Medium, 3.Low"/>
          </eAnnotations>
        </eParameters>
      </eOperations>
      <eOperations name="uploadFile" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          eExceptions="#//exception/CloudBadRequestException #//exception/CloudUnAuthorizedException #//exception/CloudAccessDeniedException #//exception/CloudConnectionException #//exception/PlatformServiceException #//exception/FileNotFoundException #//exception/IOException">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Uploads given file to Nevonex Cloud"/>
        </eAnnotations>
        <eParameters name="filePath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Absolute Path of the file"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Priority of the upload 1. High, 2. Medium, 3.Low"/>
          </eAnnotations>
        </eParameters>
      </eOperations>
      <eOperations name="uploadFile" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          eExceptions="#//exception/CloudBadRequestException #//exception/CloudUnAuthorizedException #//exception/CloudAccessDeniedException #//exception/CloudConnectionException #//exception/PlatformServiceException #//exception/FileNotFoundException #//exception/IOException">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Uploads given file to Nevonex Cloud"/>
        </eAnnotations>
        <eParameters name="file" eType="#//types/File">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="File which has to be uploaded"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Priority of the upload 1. High, 2. Medium, 3.Low"/>
          </eAnnotations>
        </eParameters>
        <eParameters name="connectionType" eType="#//common/ConnectionTypeEnum">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Type of communication which should be used for uploading File. The allowable connection types are WIFI,SATELLITE. If this value is null WIFI is selected by default."/>
          </eAnnotations>
