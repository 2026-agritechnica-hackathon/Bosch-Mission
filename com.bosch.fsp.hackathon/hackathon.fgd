  <providers fname="GPSPlugin provider">
    <features fname="GPSPlugin" machineID="5771">
      <attributes attributeControl="Subscribe" attributeName="GPSSensorPosition" attributeID="1984" attributeDesc="Internal GPS sensor information.&amp;#xD;&amp;#xA;Data members&amp;#xD;&amp;#xA;[&amp;#xD;&amp;#xA;    Latitude  -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Longitude -&gt; Default value -99.99&amp;#xD;&amp;#xA;] &amp;#xD;&amp;#xA;If no GPS signal is available, the data members will be holding &quot;null&quot; value.&amp;#xD;&amp;#xA;If GPS signal is available, and some data members are not available from the GPS sensor, then those data members will have the default values." attributeStandard="NEVONEX" attributeStandardID="" attributeArtifactUrl="" attributeMacType="" attributeFILVersion="" attributeRelVersion="" attributeCreatedby="" attributeMode="Cyclic" attributeCyclicUnit="1000ms" attributeState="Dynamic" attributeStage="DEVELOPMENT" attributeApiVersion="0.0.1" attributeUpdateRate="Adhoc/Cyclic" attributeDeviceElement="GPSPlugin" attributeDeviceClass="GPSPlugin" attributeUnit="-" attributeDataType="GPS" attributeFilDependent="YES">
        <cycleValues>1000ms</cycleValues>
        <cycleValues>2000ms</cycleValues>
        <cycleValues>10000ms</cycleValues>
        <cycleValues>30000ms</cycleValues>
        <cycleValues>60000ms</cycleValues>
        <cycleValues>300000ms</cycleValues>
        <cycleValues>600000ms</cycleValues>
        <cycleValues>5000ms</cycleValues>
      </attributes>
      <attributes attributeControl="Subscribe" attributeName="internalGpsDetailedInfo" attributeID="9288" attributeDesc="Internal GPS sensor information.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Data members description:&amp;#xD;&amp;#xA;Latitude -&gt; Latitude is the angular distance of a place North or South of the earth&apos;s equator, range:[-90, +90], unit: Degree&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Longitude -&gt; Longitude is the angular distance of a place East or West of the meridian, range:[-180, +180], unit: Degree&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Altitude -&gt; How high or low the device/location is relation to the sea level, unit: meters&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;TimeStamp -&gt; Epoch time when the GPS data transmitted from satellite, unit: milliseconds&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;HorizontalAccuracy -&gt; Measure of how close a reported position is accurate on earth surface, unit: meters              &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;VerticalAccuracy -&gt; Measure of how close a reported position is accurate to sea level, unit: meters&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;HorizontalDil -&gt; Horizontal Dilution of precision, range:[1, infinity]&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;PositionDil -&gt; Position Dilution of Precision, range:[1, infinity] (RCU target doest not provide PDOP, set to default value -99.999)&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;VerticalDil -&gt; Vertical Dilution of Precision, range:[1, infinity]&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;TimeDil -&gt; Time Dilution of Precision, range:[1, infinity]&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Speed -&gt; Speed of the GPS device, unit: km/hr&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Course -&gt; Direction in which the device is heading to, range:[0, 359.99], unit: Degree&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NumberOfSatellites -&gt; Number of satellites used in determining GPS fix&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;Data members&amp;#xD;&amp;#xA;[&amp;#xD;&amp;#xA;    Latitude  -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Longitude -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Altitude  -&gt; Default value -99.99&amp;#xD;&amp;#xA;    PacketTime (Epoch time of GPS data reception) -&gt; Default value &quot;0&quot;&amp;#xD;&amp;#xA;    Horizontal Accuracy -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Vertical Accuracy-&gt; Default value -99.99&amp;#xD;&amp;#xA;    Horizontal Dilution of Precision -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Position Dilution of Precision -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Vertical Dilution of Precision -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Time Dilution of Precision -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Speed -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Course -&gt; Default value -99.99&amp;#xD;&amp;#xA;    Number of Satellites -&gt; Default value 0&amp;#xD;&amp;#xA;]&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;If no GPS signal is available, the data members will be holding &quot;null&quot; value. &amp;#xD;&amp;#xA;If GPS signal is available, and some data members are not available from the GPS sensor, then those data members will be taking default values.&amp;#xD;&amp;#xA;" attributeStandard="NEVONEX" attributeStandardID="-" attributeArtifactUrl="" attributeMacType="" attributeFILVersion="" attributeRelVersion="" attributeCreatedby="" attributeMode="Cyclic" attributeCyclicUnit="1000ms" attributeState="Dynamic" attributeStage="DEVELOPMENT" attributeApiVersion="0.0.1" attributeUpdateRate="Adhoc/Cyclic" attributeDeviceElement="GPSPlugin" attributeDeviceClass="GPSPlugin" attributeUnit="-" attributeDataType="array" attributeFilDependent="YES">
        <attributeType xsi:type="fcal:ARRAY_TYPE" array="//@arrays.0"/>
        <cycleValues>1000ms</cycleValues>
        <cycleValues>2000ms</cycleValues>
        <cycleValues>10000ms</cycleValues>
        <cycleValues>30000ms</cycleValues>
        <cycleValues>60000ms</cycleValues>
        <cycleValues>300000ms</cycleValues>
        <cycleValues>600000ms</cycleValues>
        <cycleValues>5000ms</cycleValues>
      </attributes>
    </features>
  </providers>
