# ─────────────────────────────────────────────────────────────────────────
# SeamOS hackathon template — .gitignore
#
# COMMIT  : FSP source, app user code, customui-src source, test libs,
#           SDK runtime tarball, Claude/MCP config
# IGNORE  : build outputs, runtime dirs, machine-specific state.
#           seamos-ide regenerates .gen / .gen.tests/src / SDK src-gen on
#           project Import, so those are NOT committed.
#
# NOTE: .gitignore has no trailing/inline comments — every comment is on
#       its own line. Keep it that way.
# ─────────────────────────────────────────────────────────────────────────

# ── OS / editor junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Eclipse / seamos-ide workspace state ────────────────────────────────
.metadata/

# Zip dumps (incl. redundant hackathon_CPP_SDK.zip)
*.zip

# ── FD-generated layers (seamos-ide regenerates these on Import) ─────────
# Do NOT blanket-ignore *.gen.tests/ — testlib JARs + Manifest/feature.config
# there are required to run the simulator and are NOT regenerated.
com.bosch.fsp.*.gen/
com.bosch.fsp.*.gen.tests/src/
com.bosch.fsp.*.gen.tests/data/
com.bosch.fsp.*.gen.tests/bin/
com.bosch.fsp.*.gen.tests/target/
com.bosch.fsp.*.gen.tests/logs/

# ── C++ SDK ─────────────────────────────────────────────────────────────
# Commit ONLY the runtime tarball + info.txt + CMakeLists; everything else
# is rebuilt or re-extracted from INSTALL_x86_64.tar.xz on Import.
*_CPP_SDK/src-gen/
*_CPP_SDK/build/
*_CPP_SDK/install/
*_CPP_SDK/dependencies/lib/
*_CPP_SDK/dependencies/include/

# ── App project: build + runtime artifacts ──────────────────────────────
build/
out/
bin/
target/
install/
sdkJavaDocJar/
docs/

# App runtime dirs (recreated at run; disk/seed is the only kept exception)
hackathon_*/disk/*
!hackathon_*/disk/seed/
hackathon_*/in/
hackathon_*/out/
hackathon_*/logs/
hackathon_*/backup/
hackathon_*/.seamos-docker/

# CustomUI build output (source of truth is customui-src/)
hackathon_*/ui/*
!hackathon_*/ui/.gitkeep

# ── CustomUI react source: deps & build ─────────────────────────────────
customui-src/node_modules/
customui-src/dist/

# ── seamos-everywhere plugin local state ────────────────────────────────
# build-fif / screenshot cache (regenerated by setup)
seamos-assets/
.seamos-backup/
.seamos-docker/

# Machine-specific: embeds absolute /Users or /home paths.
# Regenerate per-clone with scripts/seamos-bootstrap.sh
.seamos-context.json

# ── Claude Code: keep shared config, drop personal/local ────────────────
.claude/settings.local.json
.claude/*.local.json
