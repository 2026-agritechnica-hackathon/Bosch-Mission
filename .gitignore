# ─────────────────────────────────────────────────────────────────────────
# SeamOS hackathon template — .gitignore
#
# COMMIT  : FSP source, FD-generated source (.gen, src-gen — cmake does
#           add_subdirectory(src-gen), so it must be present on clone),
#           app user code, customui-src source, test libs, SDK tarball,
#           Claude/MCP config
# IGNORE  : build outputs (bin/target/build), runtime dirs, machine state.
#           Generated *source* IS committed — do NOT rely on seamos-ide
#           Import to regenerate it (participants build without Import).
#
# NOTE: .gitignore has no trailing/inline comments — every comment is on
#       its own line. Keep it that way.
# ─────────────────────────────────────────────────────────────────────────

# ── OS / editor junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Eclipse / seamos-ide workspace state ────────────────────────────────
.metadata/

# Zip dumps (incl. redundant hackathon_CPP_SDK.zip)
*.zip

# ── FD-generated layers ─────────────────────────────────────────────────
# Generated SOURCE is committed (.gen java, .gen.tests src/data, SDK
# src-gen) so `clone → build` works without an IDE Import step. Only the
# compiled output (bin/target/logs) is ignored.
com.bosch.fsp.*.gen/bin/
com.bosch.fsp.*.gen/target/
com.bosch.fsp.*.gen.tests/bin/
com.bosch.fsp.*.gen.tests/target/
com.bosch.fsp.*.gen.tests/logs/

# ── C++ SDK ─────────────────────────────────────────────────────────────
# Commit src-gen (cmake add_subdirectory) + CMakeLists + runtime tarball.
# Ignore build output and the tarball-extracted lib/include (the bootstrap
# script re-extracts those from INSTALL_x86_64.tar.xz).
*_CPP_SDK/build/
*_CPP_SDK/install/
*_CPP_SDK/dependencies/lib/
*_CPP_SDK/dependencies/include/

# ── App project: build + runtime artifacts ──────────────────────────────
build/
out/
bin/
target/
install/
sdkJavaDocJar/
docs/

# App runtime dirs (recreated at run; disk/seed is the only kept exception)
hackathon_*/disk/*
!hackathon_*/disk/seed/
hackathon_*/in/
hackathon_*/out/
hackathon_*/logs/
hackathon_*/backup/
hackathon_*/.seamos-docker/

# CustomUI build output (source of truth is customui-src/)
hackathon_*/ui/*
!hackathon_*/ui/.gitkeep

# ── CustomUI react source: deps & build ─────────────────────────────────
customui-src/node_modules/
customui-src/dist/

# ── seamos-everywhere plugin local state ────────────────────────────────
# build-fif / screenshot cache (regenerated by setup)
seamos-assets/
.seamos-backup/
.seamos-docker/

# Machine-specific: embeds absolute /Users or /home paths.
# Regenerate per-clone with scripts/seamos-bootstrap.sh
.seamos-context.json

# ── Claude Code: keep shared config, drop personal/local ────────────────
.claude/settings.local.json
.claude/*.local.json
